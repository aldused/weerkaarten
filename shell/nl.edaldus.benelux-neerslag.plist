<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>nl.edaldus.benelux-neerslag</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/aldus/KNMI_Project/shell/benelux_neerslag_update.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>ECMWF_OPEN_DATA_SOURCE</key>
        <string>google</string>
    </dict>

    <!-- Elke 10 min checken: HARMONIE (lokale bin, gratis) en ECMWF (1 API-call).
         No-op zolang beide runs al gebouwd zijn. -->
    <key>StartInterval</key>
    <integer>600</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/aldus/KNMI_Project/logs/benelux_neerslag.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aldus/KNMI_Project/logs/benelux_neerslag.log</string>
</dict>
</plist>
