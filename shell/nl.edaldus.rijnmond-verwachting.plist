<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>nl.edaldus.rijnmond-verwachting</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/aldus/KNMI_Project/weerlab/shell/rijnmond_verwachting_update.sh</string>
  </array>
  <!-- Elke 30 minuten: bij nieuwe modelruns een nieuwe regioverwachting
       Rijnmond (regelgebaseerd, ~2 s) en upload naar R2. Zonder nieuwe runs
       slaat het script over; na drie uur schuiven de dagdelen en volgt altijd
       een nieuwe uitgifte. Taalredactie: RIJNMOND_REDACTIE=claude toevoegen. -->
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>RIJNMOND_REDACTIE</key>
    <string>uit</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/nl.edaldus.rijnmond-verwachting.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/nl.edaldus.rijnmond-verwachting.err</string>
</dict>
</plist>
