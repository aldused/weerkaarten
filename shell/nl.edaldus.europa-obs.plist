<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>nl.edaldus.europa-obs</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/aldus/KNMI_Project/shell/run_europa_obs.sh</string>
  </array>
  <!-- Elk half uur: :12 en :42 (METAR's komen binnen rond :55-:05 en :25-:35) -->
