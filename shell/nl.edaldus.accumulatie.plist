<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>nl.edaldus.accumulatie</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/aldus/KNMI_Project/weerlab/shell/run_accumulatie.sh</string>
  </array>
  <!-- Elke 5 minuten; RTCOR verschijnt ~1,5 min na het 5-minutenvak. -->
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <!-- ACCU_R2=1: upload naar data.weerlab.nl/accumulatie/ en /accumulatie-bijgesteld/ (live sinds 26-10-2026). -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>ACCU_R2</key>
    <string>1</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/aldus/KNMI_Project/weerlab/logs/accumulatie_launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/aldus/KNMI_Project/weerlab/logs/accumulatie_launchd.log</string>
</dict>
</plist>
