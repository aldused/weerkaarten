<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>nl.edaldus.backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/aldus/KNMI_Project/weerlab/shell/backup_weerlab.sh</string>
    </array>
    <!-- Elke nacht om 03:20. StartCalendarInterval haalt een gemiste beurt in
         zodra de Mac weer wakker is, dus een nacht uitgeschakeld is geen
         gemiste backup. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>20</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <!-- Backup mag de rest niet in de weg zitten. -->
    <key>Nice</key>
    <integer>10</integer>
    <key>LowPriorityIO</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/aldus/KNMI_Project/weerlab/logs/backup.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aldus/KNMI_Project/weerlab/logs/backup.log</string>
</dict>
</plist>
