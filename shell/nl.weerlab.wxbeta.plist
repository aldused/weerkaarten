<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>nl.weerlab.wxbeta</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/aldus/KNMI_Project/shell/wxbeta_update.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Elke 5 min checken; no-op (~3s) als geen nieuwe run, bouwt alleen bij release -->
    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/aldus/KNMI_Project/logs/wxbeta_update.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aldus/KNMI_Project/logs/wxbeta_update.log</string>
</dict>
</plist>
