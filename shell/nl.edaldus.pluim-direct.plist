<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>nl.edaldus.pluim-direct</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/aldus/KNMI_Project/weerlab/shell/pluim_direct_cache.sh</string>
  </array>

  <!-- Iedere minuut is alleen een korte HEAD-controle. Een nieuwe complete
       00/06/12/18-run activeert één ingest; de lock voorkomt overlap. -->
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>

  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>PLUIM_DIRECT_FIELDS</key>
    <string>core</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/nl.edaldus.pluim-direct.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/nl.edaldus.pluim-direct.err</string>
</dict>
</plist>
