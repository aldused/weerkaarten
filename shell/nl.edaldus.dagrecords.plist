<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>nl.edaldus.dagrecords</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/aldus/KNMI_Project/weerlab/shell/run_dagrecords.sh</string>
  </array>
  <!-- Elke 10 min; het script zelf draait alleen 05:00-23:00. Herberekent
       dagrecords_nl.json uit de door de lopend-patcher vers gehouden
       records_<nr>.json, zodat een vandaag overschreden record snel op de
       6-daagse dagrecords-kaart verschijnt. Draai bij voorkeur ~30s na
       nl.edaldus.weerrecords-lopend zodat de records al gepatcht zijn. -->
  <key>StartInterval</key>
  <integer>600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/dagrecords.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/dagrecords.err</string>
</dict>
</plist>
