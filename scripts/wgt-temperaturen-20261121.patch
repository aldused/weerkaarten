+def dag_mos_predictoren(F, mix, geldig):
+    """Freeze each UTC day's MOS predictors at the uncorrected mix maximum.
+
+    Training predicts the observed daily maximum minus the maximum of the mix.
+    Applying a different residual at every hour changes the target definition.
+    """
+    C, T = mix.shape
+    result = F.copy()
+    for begin in range(0, T, 24):
+        idx = np.arange(begin, min(begin + 24, T))
+        peak = np.argmax(np.where(geldig[:, idx] & np.isfinite(mix[:, idx]), mix[:, idx], -np.inf), 1)
+        source = np.arange(C) * T + idx[peak]
+        target = (np.arange(C)[:, None] * T + idx[None]).ravel()
+        result.iloc[target] = np.repeat(F.iloc[source].to_numpy(), len(idx), axis=0)
+    return result
 
 
