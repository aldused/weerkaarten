<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>nl.edaldus.verificatie</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>cd "/Users/aldus/KNMI_Project/weerkaarten 2" && /usr/local/bin/python3 scripts/verificatie.py && git add verificatie.json verificatie_archief.json && git diff --cached --quiet || (git commit -m "Verificatie update $(date '+%Y-%m-%d %H:%M')" && git push)</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/verificatie.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/verificatie.err</string>
</dict>
</plist>
