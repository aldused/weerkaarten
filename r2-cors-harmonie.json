{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://weerlab.nl",
          "https://www.weerlab.nl",
          "http://localhost:8090"
        ],
        "methods": [
          "GET",
          "HEAD"
        ],
        "headers": [
          "*"
        ]
      },
      "exposeHeaders": [
        "ETag"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
