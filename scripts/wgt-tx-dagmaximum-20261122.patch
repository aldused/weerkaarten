+def gemeten_tx(stations, start, nu):
+    """Read the operational KNMI ten-minute archive for the elapsed UTC day."""
+    from knmi_live_day import aggregate
+
+    uit = {}
+    for stn in stations:
+        pad = config.WEERLAB / "data" / "observations" / str(stn) / f"{start:%Y-%m-%d}.json"
+        try:
+            data = json.loads(pad.read_text())
+            rows = {}
+            for row in data["rows"]:
+                stamp = pd.Timestamp(row["time"])
+                if not start < stamp <= nu:
+                    continue
+                vals = {key: value for key in ("tx", "ta")
+                        if isinstance(value := row.get(key), (int, float)) and -55 <= value <= 55}
+                if vals:
+                    rows[stamp] = vals
+        except (OSError, ValueError, TypeError, KeyError):
+            continue
+        if not rows:
+            continue
+        laatste = max(rows)
+        verwacht = (laatste - start).total_seconds() / 600
+        if (nu - laatste).total_seconds() > 30 * 60 or len(rows) < 0.9 * verwacht:
+            continue
+        uit[stn] = (aggregate(rows.values())["tx"], laatste)
+    return uit
+
+
+def verstreken_maximum(tijden, uurveld, lats, lons, stations, gemeten, kd):
+    """Calibrate the elapsed model peak with the observed peak at each station."""
+    if not gemeten:
+        return None
+    xy = np.column_stack(static_grid._km(lats, lons))
+    modeluren = (tijden - tijden[0]).total_seconds().to_numpy() / 3600
+    peilen, afwijkingen, eindtijden = [], [], []
+    for stn, (tx, laatst) in gemeten.items():
+        s = stations[stn]
+        punt = static_grid._km(s["lat"], s["lon"])
+        d, j = kd.query(punt, k=4)
+        gewichten = 1 / np.maximum(d, 0.5)
+        reeks = np.average(uurveld[j], axis=0, weights=gewichten)
+        einduur = (laatst - tijden[0]).total_seconds() / 3600
+        einde = np.interp(einduur, modeluren, reeks, left=np.nan, right=np.nan)
+        top = np.nanmax(np.append(reeks[modeluren <= einduur], einde))
+        if np.isfinite(top):
+            peilen.append(punt)
+            afwijkingen.append(tx - top)
+            eindtijden.append(laatst)
+    if not peilen:
+        return None
+    tot = max(eindtijden)
+    uren = tijden <= tot
+    uur_tot = (tot - tijden[0]).total_seconds() / 3600
+    eind = np.searchsorted(modeluren, uur_tot)
+    waarden = uurveld[:, uren]
+    if 0 < eind < len(modeluren) and modeluren[eind] > uur_tot:
+        fractie = (uur_tot - modeluren[eind - 1]) / (modeluren[eind] - modeluren[eind - 1])
+        eindwaarde = (1 - fractie) * uurveld[:, eind - 1] + fractie * uurveld[:, eind]
+        waarden = np.column_stack((waarden, eindwaarde))
+    basis = np.nanmax(waarden, axis=1)
+    km = np.linalg.norm(xy[:, None, :] - np.asarray(peilen)[None, :, :], axis=2)
+    gewicht = np.exp(-(km / 35.0) ** 2)
+    veld = basis + (gewicht @ afwijkingen) / (gewicht.sum(1) + 0.3)
+    return veld, tot, len(peilen)
+
