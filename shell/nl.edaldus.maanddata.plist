<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>nl.edaldus.maanddata</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/aldus/KNMI_Project/weerlab/shell/run_maanddata.sh</string>
  </array>
  <!-- 09:00 vroege poging + 12:00 hoofdrun + 15:00 fallback voor late EDR-publicatie.
       Loopt parallel aan de bestaande weerkaarten-cron (02:30/06:30/10:30/14:30/18:30/22:30)
       maar geeft betrouwbaarder gisteren-cijfers in maandoverzicht.html zodra EDR ze publiceert. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>9</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>12</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>15</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
  </array>
  <key>StandardOutPath</key>
  <string>/tmp/maanddata.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/maanddata.err</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
