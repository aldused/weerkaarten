<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>nl.edaldus.tekort</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/aldus/KNMI_Project/shell/run_tekort.sh</string>
  </array>
  <!-- Dagelijks 06:00 lokale tijd, na nl.edaldus.p13records (05:20).
       ECMWF 00z is dan beschikbaar via Open-Meteo. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>6</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/tekort.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/tekort.err</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
