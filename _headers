# Cloudflare Pages — headers per pad.
# HTML moet altijd revalideren zodat updates direct doorkomen zonder hard refresh.
# Verwijzingen naar JS/CSS staan al met ?v=... in de HTML; die mogen wel cachen.

/*.html
  Cache-Control: no-cache, must-revalidate

/
  Cache-Control: no-cache, must-revalidate

# Weerkaart Europa: HTML revalideert; versies staan in JS/CSS-URLs.
/ecmwf_weerradar/
  Cache-Control: no-cache, must-revalidate

/ecmwf_weerradar/index.html
  Cache-Control: no-cache, must-revalidate

/ecmwf_weerradar/assets/*
  Cache-Control: public, max-age=86400

/ecmwf_weerradar/style.css
  Cache-Control: public, max-age=86400
