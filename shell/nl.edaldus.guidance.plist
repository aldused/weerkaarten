<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>nl.edaldus.guidance</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/aldus/KNMI_Project/weerlab/shell/guidance_update.sh</string>
  </array>
  <!-- 4x/dag, lokale tijd, elk + retry ~30 min later. De slot-skip in het
       script laat per dagdeel maar één update door; een retry loopt alleen als
       de hoofdrun faalde.
       10:15 (hoofd): ECMWF 00Z-wxbeta klaar (~09:40-10:00) + Bracknell 00Z.
       22:15 (hoofd): idem voor de 12Z-cyclus (wxbeta 12Z ~21:30-21:45 lokaal).
       04:30 en 16:00 (tussen): geen nieuwe ECMWF-run, wel verse KNMI-weerkaarten
       (HARMONIE-analyse), Bracknell-fronten en KNMI/DWD-guidance. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key><integer>4</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Hour</key><integer>5</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key><integer>10</integer>
      <key>Minute</key><integer>15</integer>
    </dict>
    <dict>
      <key>Hour</key><integer>10</integer>
      <key>Minute</key><integer>45</integer>
    </dict>
    <dict>
      <key>Hour</key><integer>16</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key><integer>16</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Hour</key><integer>22</integer>
      <key>Minute</key><integer>15</integer>
    </dict>
    <dict>
      <key>Hour</key><integer>22</integer>
      <key>Minute</key><integer>45</integer>
    </dict>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/tmp/nl.edaldus.guidance.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/nl.edaldus.guidance.err</string>
</dict>
</plist>
