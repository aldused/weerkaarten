  <array>
    <dict><key>Minute</key><integer>12</integer></dict>
    <dict><key>Minute</key><integer>42</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/tmp/europa-obs.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/europa-obs.err</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
