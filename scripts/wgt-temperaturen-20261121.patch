+        self.addCleanup(self.tmp.cleanup)
+        self.models = list(config.MODELS)
+        m = len(self.models)
+        tab = {'w': [[1/m]*m]*3, 'bias': [[0.0]*m]*3}
+        p = Path(self.tmp.name)
+        (p/'test_weights.json').write_text(json.dumps({'modellen': self.models, 'tabel': {k:tab for k in ['d0','d1','d2']}}))
+        with (p/'test_mos.pkl').open('wb') as f:
+            pickle.dump({'feats': tn.feats_voor('t10'), 'model': CaptureModel()}, f)
+        CaptureModel.frames = []
+
+    def infer(self, date='2026-10-31T12:00Z', hours=24):
+        times = pd.date_range(date, periods=hours, freq='h')
+        m, c = len(self.models), 2
+        x = np.arange(hours)
+        # Different minimum times: std(min(model)) is NOT std(model at mix minimum).
+        bas = np.stack([2 + .04*(x-((i%3)+12))**2 + i*.3 for i in range(m)])[:,None,:]
+        bas = np.broadcast_to(bas,(m,c,hours)).copy()
+        t2 = bas+2
+        wind = np.broadcast_to((1+x/10)[None,None,:],bas.shape).copy()
+        cloud = np.full_like(bas,.3)
