{
    "$defs": {
        "AreaDescription": {
            "description": "Human-readable description of the area field in two languages",
            "properties": {
                "en": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Auto-generated area description in English.",
                    "title": "En"
                },
                "nl": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Auto-generated area description in Dutch.",
                    "title": "Nl"
                }
            },
            "title": "AreaDescription",
            "type": "object"
        },
        "Certainty": {
            "description": "Certainty values for a warning, based on Probability.",
            "enum": [
                "Observed",
                "Likely",
                "Possible",
                "Unlikely"
            ],
            "title": "Certainty",
            "type": "string"
        },
        "Color": {
            "description": "Colors of a weather warning",
            "enum": [
                "yellow",
                "orange",
                "red"
            ],
            "title": "Color",
            "type": "string"
        },
        "Coordinates": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
                {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "integer"
                        }
                    ],
                    "ge": -180,
                    "le": 180,
                    "title": "Coordinate longitude"
                },
                {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "integer"
                        }
                    ],
                    "ge": -90,
                    "le": 90,
                    "title": "Coordinate latitude"
                }
            ],
            "type": "array"
        },
        "Domain": {
            "description": "List of allowed domains",
            "enum": [
                "aviation",
                "maritime",
                "public"
            ],
            "title": "Domain",
            "type": "string"
        },
        "Guidance": {
            "description": "Auto-generated information for the audience: what to expect, what to do. Added in an enrichment step.",
            "properties": {
                "impact": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Text describing the possible impact of the meteorological events.",
                    "title": "Impact"
                },
                "instruction": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Text describing actions that the audience could take or avoid.",
                    "title": "Instruction"
                }
            },
            "title": "Guidance",
            "type": "object"
        },
        "GuidanceByLanguage": {
            "description": "Guidance in two languages",
            "properties": {
                "en": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Guidance"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Auto-generated guidance in English."
                },
                "nl": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Guidance"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Auto-generated guidance in Dutch."
                }
            },
            "title": "GuidanceByLanguage",
            "type": "object"
        },
        "Incident": {
            "description": "An incident such as a named storm can be linked to several WarningSets, such as a WarningSet for Rain, another WarningSet for Wind, etc.",
            "properties": {
                "incident_name": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Name of the incident, if applicable. Example: Storm Andrew.",
                    "title": "Incident Name"
                },
                "incident_uuid": {
                    "description": "UUID of the incident, auto-generated by the database.",
                    "format": "uuid",
                    "title": "Incident Uuid",
                    "type": "string"
                }
            },
            "required": [
                "incident_uuid"
            ],
            "title": "Incident",
            "type": "object"
        },
        "Metadata": {
            "description": "Metadata for the dataset.",
            "properties": {
                "domain": {
                    "$ref": "#/$defs/Domain",
                    "default": "public",
                    "description": "Domain of the warnings in the file."
                },
                "generated_at": {
                    "description": "Timestamp of the generation of the file, in ISO8601 format, UTC timezone.",
                    "title": "Generated At",
                    "type": "string"
                },
                "producer": {
                    "$ref": "#/$defs/Producer"
                },
                "publication_type": {
                    "$ref": "#/$defs/PublicationType",
                    "default": "manual",
                    "description": "Files of 'manual' publication type were published by a meteorologist creating or updating a warning, 'heartbeat' publications are generated automatically on a schedule (daily, exact time to be determined) and are identical to the previous publication, 'test' publications are for system tests."
                },
                "schema_version": {
                    "default": "0.7",
                    "description": "Schema version of the JSON structure.",
                    "title": "Schema Version",
                    "type": "string"
                },
                "snapshot_uuid": {
                    "description": "Unique identifier of the file, used in the filename. Auto-generated while publishing.",
                    "format": "uuid",
                    "title": "Snapshot Uuid",
                    "type": "string"
                }
            },
            "required": [
                "generated_at",
                "producer",
                "snapshot_uuid"
            ],
            "title": "Metadata",
            "type": "object"
        },
        "MultiPolygonModel": {
            "properties": {
                "coordinates": {
                    "items": {
                        "items": {
                            "items": {
                                "$ref": "#/$defs/Coordinates"
                            },
                            "type": "array"
                        },
                        "type": "array"
                    },
                    "title": "Coordinates",
                    "type": "array"
                },
                "type": {
                    "default": "MultiPolygon",
                    "title": "Multi Polygon",
                    "type": "string"
                }
            },
            "required": [
                "coordinates"
            ],
            "title": "MultiPolygonModel",
            "type": "object"
        },
        "OperationalStatus": {
            "description": "Status denoting appropriate handling of the warning: 'Actual' is a real warning requiring action on the recipients' part.",
            "enum": [
                "Actual",
                "Exercise",
                "System",
                "Test"
            ],
            "title": "OperationalStatus",
            "type": "string"
        },
        "Phenomenon": {
            "description": "List of allowed phenomena",
            "enum": [
                "road-ice",
                "snow",
                "high-temperature",
                "low-temperature",
                "fog",
                "thunderstorm",
                "waterspouts",
                "wind",
                "rain"
            ],
            "title": "Phenomenon",
            "type": "string"
        },
        "PolygonModel": {
            "properties": {
                "coordinates": {
                    "items": {
                        "items": {
                            "$ref": "#/$defs/Coordinates"
                        },
                        "type": "array"
                    },
                    "title": "Coordinates",
                    "type": "array"
                },
                "type": {
                    "default": "Polygon",
                    "title": "Polygon",
                    "type": "string"
                }
            },
            "required": [
                "coordinates"
            ],
            "title": "PolygonModel",
            "type": "object"
        },
        "ProbabilityPercentageRange": {
            "description": "Intervals are closed on the lower end and open on the upper end, meaning lower_end <= probability < upper_end.",
            "enum": [
                "10-30",
                "30-60",
                "60-90",
                "90-100"
            ],
            "title": "ProbabilityPercentageRange",
            "type": "string"
        },
        "Producer": {
            "description": "Data of the producer of the warnings.",
            "properties": {
                "contact": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Contact for the warnings.",
                    "title": "Contact"
                },
                "id": {
                    "default": "2.49.0.0.528.0",
                    "description": "Organization ID assigned to KNMI by the World Meteorological Organization (WMO).",
                    "title": "Id",
                    "type": "string"
                },
                "name": {
                    "default": "KNMI",
                    "description": "These warnings are produced by KNMI.",
                    "title": "Name",
                    "type": "string"
                }
            },
            "title": "Producer",
            "type": "object"
        },
        "PublicationType": {
            "description": "List of allowed publication types for the UniformWarningDataset Manual: triggered by a new or updated Published Warning (action by meteorologist-on-duty) Heartbeat: triggered by a CRON job, showing every day that the functionality is still alive Test: for production testing",
            "enum": [
                "manual",
                "heartbeat",
                "test"
            ],
            "title": "PublicationType",
            "type": "string"
        },
        "ResponseType": {
            "description": "Values for optional ResponseType field",
            "enum": [
                "Shelter",
                "Evacuate",
                "Prepare",
                "Execute",
                "Avoid",
                "Monitor",
                "Assess",
                "AllClear",
                "None"
            ],
            "title": "ResponseType",
            "type": "string"
        },
        "Severity": {
            "description": "Severity levels for each WarningPart.",
            "enum": [
                "Moderate",
                "Severe",
                "Extreme"
            ],
            "title": "Severity",
            "type": "string"
        },
        "Status": {
            "description": "List of allowed statuses for a published warning. Note: only 'active' and 'cancelled' are set by meteorologist, while 'expired' is an auto-update performed by post-processing code.",
            "enum": [
                "active",
                "cancelled",
                "expired"
            ],
            "title": "Status",
            "type": "string"
        },
        "WarningPart": {
            "description": "An individual part of a Warning Set.",
            "properties": {
                "area": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/PolygonModel"
                        },
                        {
                            "$ref": "#/$defs/MultiPolygonModel"
                        }
                    ],
                    "description": "A GeoJSON (RFC 7946) Polygon or MultiPolygon of the affected area, WGS84-coordinates (lon/lat). Closed ring, no holes, counterclockwise.",
                    "title": "Area"
                },
                "area description": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/AreaDescription"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "A description of the GeoJSON object in the 'area' field."
                },
                "certainty": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Certainty"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The code denoting the certainty of a warning. Added in an enrichment step."
                },
                "color": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Color"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Representation of warning level, computed from severity in an enrichment step."
                },
                "expires": {
                    "description": "End time of this warning part. Not required when equal to the WarningSet.expires field.",
                    "format": "date-time",
                    "title": "Expires",
                    "type": "string"
                },
                "guidance": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/GuidanceByLanguage"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "Auto-generated information for the audience: what to expect, what to do. Added in an enrichment step."
                },
                "onset": {
                    "description": "Start time of this warning part. Not required when equal to the WarningSet.onset field.",
                    "format": "date-time",
                    "title": "Onset",
                    "type": "string"
                },
                "part_uuid": {
                    "description": "Stable identifier for this WarningPart. Also used for the identifier field in CAP.",
                    "format": "uuid",
                    "title": "Part Uuid",
                    "type": "string"
                },
                "probability_percentage_range": {
                    "$ref": "#/$defs/ProbabilityPercentageRange",
                    "description": "Probability of the described weather, in a range of percentages."
                },
                "response_type": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/ResponseType"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "description": "The type of action recommended for the target audience. Added in an enrichment step."
                },
                "severity": {
                    "$ref": "#/$defs/Severity",
                    "description": "Severity of this Warning Part."
                },
                "status": {
                    "$ref": "#/$defs/Status",
                    "default": "active",
                    "description": "Indicating current status of a WarningPart. When CANCELLED or EXPIRED, it will appear in a snapshot one more time."
                },
                "version_dt": {
                    "description": "Denotes when this WarningPart was last updated.",
                    "format": "date-time",
                    "title": "Version Dt",
                    "type": "string"
                },
                "version_id": {
                    "description": "Denotes which update this is for this WarningPart.",
                    "title": "Version Id",
                    "type": "integer"
                }
            },
            "required": [
                "part_uuid",
                "version_id",
                "version_dt",
                "severity",
                "area",
                "onset",
                "expires",
                "probability_percentage_range"
            ],
            "title": "WarningPart",
            "type": "object"
        },
        "WarningSet": {
            "description": "A Warning Set contains one or multiple warning parts for the same weather event. Two warning sets with the same phenomenon are not allowed to overlap in time. All UUID fields will be auto-generated by the Warning Administration database.",
            "properties": {
                "domain": {
                    "$ref": "#/$defs/Domain",
                    "default": "public",
                    "description": "Domain of the warning."
                },
                "expires": {
                    "description": "Expiration time of the Warning Set, equal to the last 'expires' value of the Warning Parts (timezone UTC, format ISO8601).",
                    "format": "date-time",
                    "title": "Expires",
                    "type": "string"
                },
                "incident": {
                    "$ref": "#/$defs/Incident",
                    "description": "Relation of the Warning Set to an incident, such as a named storm."
                },
                "onset": {
                    "description": "Start time of the Warning Set, equal to the first 'onset' time of the Warning Parts (timezone UTC, format ISO8601).",
                    "format": "date-time",
                    "title": "Onset",
                    "type": "string"
                },
                "operational_status": {
                    "$ref": "#/$defs/OperationalStatus",
                    "default": "Actual",
                    "description": "Operational Status indicates an actual Warning Set vs a system test."
                },
                "parts": {
                    "description": "Individual Warning Part objects. Ordering of this list may change, use part_uuid to keep track of specific WarningPart objects.",
                    "items": {
                        "$ref": "#/$defs/WarningPart"
                    },
                    "title": "Parts",
                    "type": "array"
                },
                "phenomenon": {
                    "$ref": "#/$defs/Phenomenon",
                    "description": "Phenomenon of the Warning Set. Is the same for each part."
                },
                "status": {
                    "$ref": "#/$defs/Status",
                    "default": "active",
                    "description": "Indicating current status of a Warning Set. When CANCELLED or EXPIRED, it will appear in a snapshot one more time."
                },
                "texts": {
                    "$ref": "#/$defs/WarningTextByLanguage",
                    "description": "Descriptions and explanations written by meteorologist in Dutch and English."
                },
                "version_dt": {
                    "description": "When the current version was published (timezone UTC, format ISO8601).",
                    "format": "date-time",
                    "title": "Version Dt",
                    "type": "string"
                },
                "version_id": {
                    "description": "Integer denoting the version of a WarningSet object, '1' for initial object, incrementing with each update.",
                    "title": "Version Id",
                    "type": "integer"
                },
                "warning_set_uuid": {
                    "description": "The warning_set_uuid is the stable identifier for a single WarningSet and stays the same over all versions of the object.",
                    "format": "uuid",
                    "title": "Warning Set Uuid",
                    "type": "string"
                },
                "warning_type": {
                    "$ref": "#/$defs/WarningType",
                    "description": "Type of a warning. Is it currently in effect ('warning') or is it an early indication of potentially dangerous weather"
                }
            },
            "required": [
                "phenomenon",
                "onset",
                "expires",
                "texts",
                "warning_type",
                "incident",
                "parts",
                "warning_set_uuid",
                "version_id",
                "version_dt"
            ],
            "title": "WarningSet",
            "type": "object"
        },
        "WarningText": {
            "description": "Descriptions and explanations written by meteorologist",
            "properties": {
                "description": {
                    "description": "Concise meteorological summary of a Warning Set.",
                    "maxLength": 65536,
                    "minLength": 20,
                    "title": "Description",
                    "type": "string"
                },
                "detailed_description": {
                    "default": "",
                    "description": "Detailed meteorological description of a Warning Set.",
                    "minLength": 0,
                    "title": "Detailed Description",
                    "type": "string"
                },
                "headline": {
                    "description": "Short headline to describe a WarningSet",
                    "maxLength": 255,
                    "title": "Headline",
                    "type": "string"
                }
            },
            "required": [
                "headline",
                "description"
            ],
            "title": "WarningText",
            "type": "object"
        },
        "WarningTextByLanguage": {
            "description": "Container for Dutch and English explanations",
            "properties": {
                "en": {
                    "$ref": "#/$defs/WarningText",
                    "description": "Explanation in English."
                },
                "nl": {
                    "$ref": "#/$defs/WarningText",
                    "description": "Explanation in Dutch."
                }
            },
            "required": [
                "nl",
                "en"
            ],
            "title": "WarningTextByLanguage",
            "type": "object"
        },
        "WarningType": {
            "description": "List of allowed warning types",
            "enum": [
                "potentially-dangerous-weather",
                "warning"
            ],
            "title": "WarningType",
            "type": "string"
        }
    },
    "description": "A snapshot is one file that describes the current and future weather situation. All warnings and early warnings are included.",
    "properties": {
        "metadata": {
            "$ref": "#/$defs/Metadata",
            "description": "Metadata for the file."
        },
        "num_warning_sets": {
            "description": "Number of warning sets in the dataset.",
            "title": "Num Warning Sets",
            "type": "integer"
        },
        "num_warnings": {
            "description": "Number of warning parts in the dataset.",
            "title": "Num Warnings",
            "type": "integer"
        },
        "warnings": {
            "description": "Sets of warnings.",
            "items": {
                "$ref": "#/$defs/WarningSet"
            },
            "title": "Warnings",
            "type": "array"
        }
    },
    "required": [
        "metadata",
        "num_warning_sets",
        "num_warnings",
        "warnings"
    ],
    "title": "Snapshot",
    "type": "object"
}
