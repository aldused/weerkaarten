<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>nl.edaldus.pluimtrend</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/aldus/KNMI_Project/weerlab/shell/pluim_trend_cache.sh</string>
  </array>
  <!-- Lichtgewicht metadata-poll. Eén minuut voorkomt vooral in de ochtend
       onnodige vertraging van de nieuwe 00Z-run. Alleen een nieuwe, volledige
       en geverifieerde run activeert de downloads en R2-upload. -->
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/tmp/nl.edaldus.pluimtrend.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/nl.edaldus.pluimtrend.err</string>
</dict>
</plist>
