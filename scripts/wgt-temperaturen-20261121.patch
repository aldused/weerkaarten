+def toets_vorstkans(R):
+    """Probabilities calibrated only on earlier walk-forward residuals (2-day gap)."""
+    from scipy.stats import norm
+    R = R.reset_index(drop=True)
+    dates = pd.to_datetime(R["t"], utc=True)
+    lead = R["L"].map({"d0": 0, "d1": 1, "d2": 2}).to_numpy()
+    residual = (R["obs"] - R["nacht_mos"]).to_numpy()
+    spread = R["spread"].to_numpy()
+    obs = (R["obs"].to_numpy() < 0).astype(float)
+    prob, clim = np.full(len(R), np.nan), np.full(len(R), np.nan)
+    month_num = dates.dt.month.to_numpy()
+    month_code = dates.dt.year.to_numpy() * 12 + month_num - 1
+    for month in np.unique(month_code):
+        start = pd.Timestamp(year=int(month // 12), month=int(month % 12 + 1), day=1, tz="UTC")
+        past = (dates < start - pd.Timedelta(days=2)).to_numpy() & np.isfinite(residual)
+        target = month_code == month
+        if past.sum() < 500 or any((past & (lead == k)).sum() < 50 for k in range(3)):
+            continue
+        par = sigma_fit(residual[past], lead[past], spread[past])
+        prob[target] = norm.cdf(-R.loc[target, "nacht_mos"].to_numpy() / sigma_van(par, lead[target], spread[target]))
+        # Seasonal climatology also uses only preceding observations.
+        dist = np.minimum(abs(month_num - start.month), 12 - abs(month_num - start.month))
+        season = past & (dist <= 1)
+        clim[target] = obs[season if season.sum() >= 100 else past].mean()
+    ok = np.isfinite(prob) & np.isfinite(clim)
+    if not ok.any():
+        return {"methode": "chronologisch, 2 dagen tussen kalibratie en toets", "n": 0}
+    bs, bk = np.mean((prob[ok] - obs[ok])**2), np.mean((clim[ok] - obs[ok])**2)
+    bins = np.digitize(prob, [.1, .3, .5, .7, .9])
+    reliability=[]
+    for k,label in enumerate(['0–10%', '10–30%', '30–50%', '50–70%', '70–90%', '90–100%']):
+        sel=ok & (bins==k)
+        if sel.any():
+            reliability.append({"kans":label,"n":int(sel.sum()),"verwacht":round(float(prob[sel].mean()),3),"gemeten":round(float(obs[sel].mean()),3)})
+    return {"methode":"chronologisch, sigma en seizoensklimatologie alleen uit eerdere nachten; 2 dagen tussenruimte",
+            "n":int(ok.sum()),"overgeslagen":int((~ok).sum()),"brier":round(float(bs),4),"brier_klimatologie":round(float(bk),4),
+            "skill":round(float(1-bs/bk),3) if bk>0 else None,"betrouwbaarheid":reliability}
+
