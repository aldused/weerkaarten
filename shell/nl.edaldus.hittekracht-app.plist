<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>nl.edaldus.hittekracht-app</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/aldus/KNMI_Project/weerlab/shell/run_hittekracht_app.sh</string>
  </array>
  <!-- Elke 30 min, 24/7; publiceert alleen bij inhoudelijke wijziging.
       24/7 zodat de dag-hittekracht bij middernacht naar de nieuwe dag
       verspringt. Houdt de app-hittekracht (vandaag+morgen) per KNMI-station
       actueel op demo_hittekracht_app.html (beta-tab). -->
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/hittekracht-app.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/hittekracht-app.err</string>
</dict>
</plist>
